{
  "name": "cpmm-shield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Settlement-first x402 payment orchestrator for validated Algorand resources",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "client:unpaid": "tsx client/unpaid-client.ts",
    "client:paid": "tsx client/paid-client.ts",
    "client:agent": "tsx client/agent-client.ts",
    "client:shield": "tsx client/agent-client.ts",
    "demo:scripted": "tsx client/scripted-shield-client.ts",
    "x402": "tsx scripts/x402-cli.ts",
    "sandbox": "tsx scripts/agent-sandbox.ts",
    "simulate": "tsx scripts/payment-flow-simulator.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@x402-avm/extensions": "2.6.1",
    "@x402/avm": "2.19.0",
    "@x402/core": "2.19.0",
    "@x402/fetch": "2.19.0",
    "@x402/hono": "2.19.0",
    "algosdk": "3.6.0",
    "dotenv": "17.2.1",
    "hono": "4.13.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.28.2"
}
